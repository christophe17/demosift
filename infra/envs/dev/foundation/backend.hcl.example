# Copy to backend.hcl (gitignored) once the state bucket exists, and replace ACCOUNT_ID.
bucket       = "demosift-tfstate-dev-ACCOUNT_ID"
key          = "envs/dev/foundation.tfstate"
region       = "eu-central-1"
use_lockfile = true
encrypt      = true
# kms_key_id = "alias/demosift-dev-tfstate" # uncomment once the bucket uses a customer-managed key
